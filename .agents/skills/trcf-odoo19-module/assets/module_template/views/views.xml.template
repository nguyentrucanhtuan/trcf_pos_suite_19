<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_trcf_${model_name}_list" model="ir.ui.view">
        <field name="name">trcf.${model_name}.list</field>
        <field name="model">trcf.${model_name}</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_trcf_${model_name}_form" model="ir.ui.view">
        <field name="name">trcf.${model_name}.form</field>
        <field name="model">trcf.${model_name}</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_done" string="Hoàn tất" type="object" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_draft" string="Cài về nháp" type="object" invisible="state not in ['confirmed', 'cancel']"/>
                    <button name="action_cancel" string="Hủy" type="object" invisible="state in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VD: Tên đơn hàng..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_trcf_${model_name}_search" model="ir.ui.view">
        <field name="name">trcf.${model_name}.search</field>
        <field name="model">trcf.${model_name}</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Của tôi" name="my_items" domain="[('user_id', '=', uid)]"/>
                <filter string="Hôm nay" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Gom nhóm theo">
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Người phụ trách" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
