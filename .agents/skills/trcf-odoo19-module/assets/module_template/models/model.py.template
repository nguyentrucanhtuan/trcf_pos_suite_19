# -*- coding: utf-8 -*-
from odoo import models, fields, api, _
from odoo.exceptions import ValidationError

class ${class_name}(models.Model):
    _name = 'trcf.${model_name}'
    _description = '${description}'
    _inherit = ['mail.thread', 'mail.activity.mixin']
    _order = 'id desc'
    _check_company_auto = True

    # SQL Constraints (Odoo 19 syntax)
    _name_unique = models.Constraint(
        'UNIQUE(name, company_id)',
        'Tên phải là duy nhất trong cùng công ty!',
    )

    name = fields.Char(string='Tên', required=True, index=True, tracking=True)
    active = fields.Boolean(default=True)
    date = fields.Date(string='Ngày', default=fields.Date.context_today)
    user_id = fields.Many2one('res.users', string='Người phụ trách', default=lambda self: self.env.user)
    company_id = fields.Many2one(
        'res.company', string='Công ty',
        default=lambda self: self.env.company,
        required=True, index=True,
    )

    state = fields.Selection([
        ('draft', 'Nháp'),
        ('confirmed', 'Xác nhận'),
        ('done', 'Hoàn tất'),
        ('cancel', 'Đã hủy'),
    ], string='Trạng thái', default='draft', tracking=True)

    @api.model_create_multi
    def create(self, vals_list):
        # TODO: Thêm logic kiểm tra hoặc xử lý trước khi tạo
        return super().create(vals_list)

    def action_confirm(self):
        self.write({'state': 'confirmed'})

    def action_done(self):
        self.write({'state': 'done'})

    def action_cancel(self):
        self.write({'state': 'cancel'})

    def action_draft(self):
        self.write({'state': 'draft'})

