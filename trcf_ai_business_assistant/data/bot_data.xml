<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_ai_assistant" model="res.partner">
            <field name="name">TRCF AI Assistant</field>
            <field name="email">ai_assistant@coffeetree.vn</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="user_ai_assistant" model="res.users">
            <field name="login">trcf_ai_assistant</field>
            <field name="password">trcf_ai_assistant_secure_pass</field>
            <field name="partner_id" ref="partner_ai_assistant"/>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
