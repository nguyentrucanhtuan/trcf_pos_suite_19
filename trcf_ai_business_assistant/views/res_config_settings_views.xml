<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings view inherit - Thêm vào General Settings -->
    <record id="res_config_settings_view_form_inherit_trcf_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.trcf.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Thêm block mới vào General Settings app -->
            <xpath expr="//app[@name='general_settings']//block[@name='integration']" position="after">
                <block title="TRCF AI Assistant" name="trcf_ai_settings">
                    <setting string="Google API Key" help="API Key để sử dụng Google Gemini AI">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="gemini_api_key" class="col-lg-3"/>
                                <field name="gemini_api_key" class="col-lg-6" password="True"/>
                            </div>
                        </div>
                    </setting>
                    
                    <setting string="Trend Period" help="Số ngày để tính xu hướng món bán chạy">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="drink_trend_period" class="col-lg-3"/>
                                <field name="drink_trend_period" class="col-lg-2"/>
                                <span class="ms-2">ngày</span>
                            </div>
                        </div>
                    </setting>
                    
                    <setting string="Quy tắc pha chế" help="Các quy tắc mà AI tuân theo khi gợi ý món sáng tạo">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="drink_creativity_rules" class="col-lg-12" 
                                       placeholder="VD:
1. Tỷ lệ espresso/sữa: 1:3
2. Độ ngọt: 15-20%
3. Topping tối đa 3 loại"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
