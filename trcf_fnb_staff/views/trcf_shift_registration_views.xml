<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ===== TREE VIEW ===== -->
    <record id="trcf_shift_registration_view_tree" model="ir.ui.view">
        <field name="name">trcf.shift.registration.tree</field>
        <field name="model">trcf.shift.registration</field>
        <field name="arch" type="xml">
            <list string="Danh sách đăng ký ca" decoration-success="state=='confirmed'" decoration-danger="state=='rejected'" expand="1" default_order="date desc">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="shift_time_display" string="Thời gian"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state=='confirmed'" decoration-danger="state=='rejected'"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ===== FORM VIEW ===== -->
    <record id="trcf_shift_registration_view_form" model="ir.ui.view">
        <field name="name">trcf.shift.registration.form</field>
        <field name="model">trcf.shift.registration</field>
        <field name="arch" type="xml">
            <form string="Đăng ký ca">
                <header>
                    <button name="action_confirm" string="Duyệt" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Từ chối" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Đặt lại" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin đăng ký">
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Ca làm việc">
                            <field name="shift_id"/>
                            <field name="shift_time_display" string="Thời gian"/>
                        </group>
                    </group>
                    <group string="Ghi chú">
                        <field name="note" nolabel="1" placeholder="Ghi chú của nhân viên..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="trcf_shift_registration_view_search" model="ir.ui.view">
        <field name="name">trcf.shift.registration.search</field>
        <field name="model">trcf.shift.registration</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đăng ký">
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="date"/>
                <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã duyệt" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Từ chối" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Nhóm theo Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Nhóm theo Ngày" name="group_date" context="{'group_by': 'date:day'}"/>
                <filter string="Nhóm theo Ca" name="group_shift" context="{'group_by': 'shift_id'}"/>
            </search>
        </field>
    </record>

    <!-- ===== CALENDAR VIEW ===== -->
    <record id="trcf_shift_registration_view_calendar" model="ir.ui.view">
        <field name="name">trcf.shift.registration.calendar</field>
        <field name="model">trcf.shift.registration</field>
        <field name="arch" type="xml">
            <calendar string="Lịch đăng ký" date_start="date" color="shift_id" mode="month" event_open_popup="true">
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="trcf_shift_registration_action" model="ir.actions.act_window">
        <field name="name">Đăng ký ca</field>
        <field name="res_model">trcf.shift.registration</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_group_date': 1, 'search_default_group_shift': 1, 'expand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có đăng ký ca nào!
            </p>
            <p>
                Nhân viên có thể đăng ký ca từ trang <a href="/shift-registration">/shift-registration</a>
            </p>
        </field>
    </record>

    <!-- ===== MENU ===== -->
    <menuitem id="trcf_shift_registration_menu"
              name="Đăng ký ca"
              parent="trcf_shift_management_menu_root"
              action="trcf_shift_registration_action"
              sequence="30"/>

</odoo>
