<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ===== TREE VIEW ===== -->
    <record id="trcf_shift_task_view_tree" model="ir.ui.view">
        <field name="name">trcf.shift.task.tree</field>
        <field name="model">trcf.shift.task</field>
        <field name="arch" type="xml">
            <list string="Công việc" decoration-success="state=='done'" decoration-danger="state=='overdue'" decoration-muted="state=='cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="time_display" string="Khung giờ"/>
                <field name="assigned_employee_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='pending'" 
                       decoration-warning="state=='in_progress'"
                       decoration-success="state=='done'" 
                       decoration-danger="state in ('overdue','cancelled')"/>
                <field name="completed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ===== FORM VIEW ===== -->
    <record id="trcf_shift_task_view_form" model="ir.ui.view">
        <field name="name">trcf.shift.task.form</field>
        <field name="model">trcf.shift.task</field>
        <field name="arch" type="xml">
            <form string="Công việc">
                <header>
                    <button name="action_start" string="Bắt đầu" type="object" 
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_done" string="Hoàn thành" type="object" 
                            class="btn-success" invisible="state not in ('pending', 'in_progress')"/>
                    <button name="action_cancel" string="Hủy" type="object" 
                            class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" string="Đặt lại" type="object" 
                            class="btn-secondary" invisible="state not in ('done', 'cancelled', 'overdue')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Thông tin">
                            <field name="date"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="template_id" readonly="1"/>
                        </group>
                        <group string="Phân công">
                            <field name="assigned_employee_id"/>
                            <field name="completed_by" readonly="1" invisible="state != 'done'"/>
                            <field name="completed_at" readonly="1" invisible="state != 'done'"/>
                        </group>
                    </group>
                    
                    <group string="Mô tả công việc">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    
                    <group string="Ghi chú hoàn thành" invisible="state != 'done'">
                        <field name="note" nolabel="1" placeholder="Ghi chú khi hoàn thành..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="trcf_shift_task_view_search" model="ir.ui.view">
        <field name="name">trcf.shift.task.search</field>
        <field name="model">trcf.shift.task</field>
        <field name="arch" type="xml">
            <search string="Tìm công việc">
                <field name="name"/>
                <field name="assigned_employee_id"/>
                <field name="date"/>
                <filter string="Hôm nay" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Tuần này" name="this_week" domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Chờ thực hiện" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Đang thực hiện" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Hoàn thành" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Quá hạn" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <separator/>
                <filter string="Nhóm theo Ngày" name="group_date" context="{'group_by': 'date'}"/>
                <filter string="Nhóm theo NV" name="group_employee" context="{'group_by': 'assigned_employee_id'}"/>
                <filter string="Nhóm theo Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ===== KANBAN VIEW ===== -->
    <record id="trcf_shift_task_view_kanban" model="ir.ui.view">
        <field name="name">trcf.shift.task.kanban</field>
        <field name="model">trcf.shift.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="date"/>
                <field name="time_display"/>
                <field name="assigned_employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div class="text-muted">
                                <field name="date"/> | <field name="time_display"/>
                            </div>
                            <div>
                                <field name="assigned_employee_id" widget="many2one_avatar_employee"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== CALENDAR VIEW ===== -->
    <record id="trcf_shift_task_view_calendar" model="ir.ui.view">
        <field name="name">trcf.shift.task.calendar</field>
        <field name="model">trcf.shift.task</field>
        <field name="arch" type="xml">
            <calendar string="Lịch công việc" date_start="date" color="assigned_employee_id" mode="week" event_open_popup="true">
                <field name="name"/>
                <field name="assigned_employee_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="trcf_shift_task_action" model="ir.actions.act_window">
        <field name="name">Công việc</field>
        <field name="res_model">trcf.shift.task</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có công việc nào!
            </p>
            <p>
                Tạo mẫu công việc và nhấn "Tạo lịch tuần" để tự động tạo công việc.
            </p>
        </field>
    </record>

    <!-- ===== MENU ===== -->
    <menuitem id="trcf_shift_task_menu"
              name="Công việc"
              parent="trcf_shift_management_menu_root"
              action="trcf_shift_task_action"
              sequence="45"/>

</odoo>
