<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="kitchen_dashboard_action" model="ir.actions.client">
        <field name="name">Kitchen Dashboard Screen</field>
        <field name="tag">kitchen_dashboard_tags</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="trcf_unified_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard Tổng Hợp (Bếp + Công Việc)</field>
        <field name="tag">trcf_unified_dashboard_tags</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="view_trcf_kitchenscreen_list" model="ir.ui.view">
        <field name="name">trcf.kitchenscreen.list</field>
        <field name="model">trcf.kitchenscreen</field>
        <field name="arch" type="xml">
            <list>
                <field name="screen_name"/>
                <field name="pos_config_id"/>
                <field name="is_active"/>
                <button name="%(kitchen_dashboard_action)d"
                    type="action"
                    string="Màn hình bếp"
                    icon="fa-television"
                    />
                <button name="%(trcf_unified_dashboard_action)d"
                    type="action"
                    string="Màn hình tổng hợp"
                    icon="fa-list-alt"
                    />
            </list>
        </field>
    </record>

    <record id="view_trcf_kitchenscreen_form" model="ir.ui.view">
        <field name="name">trcf.kitchenscreen.form</field>
        <field name="model">trcf.kitchenscreen</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="screen_name"/>
                        <field name="pos_config_id"/>
                        <field name="pos_categ_ids"/>
                        <field name="is_active"/>
                    </group>
                    <button name="%(kitchen_dashboard_action)d"
                        type="action"
                        string="Màn hình bếp"
                        class="btn-secondary me-2"
                        />
                    <button name="%(trcf_unified_dashboard_action)d"
                        type="action"
                        string="Màn hình tổng hợp"
                        class="btn-primary"
                        />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trcf_kitchenscreen" model="ir.actions.act_window">
        <field name="name">Màn hình bếp</field>
        <field name="res_model">trcf.kitchenscreen</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_trcf_kitchenscreen_list"/>
    </record>

    <!-- Menu Root: TRCF Màn hình bếp (ngang hàng với TRCF Quản lý ca) -->
    <menuitem
        id="menu_trcf_kitchen_root"
        name="TRCF Màn hình bếp"
        sequence="28"/>
    
    <!-- Submenu: Cấu hình màn hình bếp -->
    <menuitem
        id="menu_trcf_kitchen_config"
        name="Cấu hình màn hình"
        parent="menu_trcf_kitchen_root"
        sequence="10"
        action="action_trcf_kitchenscreen"/>
</odoo>
 