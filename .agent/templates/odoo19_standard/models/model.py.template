# -*- coding: utf-8 -*-
# Template: Odoo 19 Standard Model
# Variables: {{MODEL_CLASS}}, {{MODEL_NAME}}, {{MODEL_DESCRIPTION}}

from odoo import api, fields, models, _
from odoo.exceptions import UserError, ValidationError

import logging
_logger = logging.getLogger(__name__)


class {{MODEL_CLASS}}(models.Model):
    """
    {{MODEL_DESCRIPTION}}
    """
    _name = '{{MODEL_NAME}}'
    _description = '{{MODEL_DESCRIPTION}}'
    _order = 'create_date desc'
    _rec_name = 'name'

    # =============================================
    # FIELDS
    # =============================================
    name = fields.Char(
        string='Tên',
        required=True,
        index=True,
        tracking=True,
    )
    active = fields.Boolean(
        string='Hoạt động',
        default=True,
    )
    state = fields.Selection(
        selection=[
            ('draft', 'Nháp'),
            ('confirmed', 'Xác nhận'),
            ('done', 'Hoàn thành'),
            ('cancelled', 'Đã hủy'),
        ],
        string='Trạng thái',
        default='draft',
        tracking=True,
    )
    description = fields.Text(string='Mô tả')
    date = fields.Date(
        string='Ngày',
        default=fields.Date.context_today,
    )
    
    # Relational fields
    partner_id = fields.Many2one(
        comodel_name='res.partner',
        string='Đối tác',
        ondelete='restrict',
    )
    company_id = fields.Many2one(
        comodel_name='res.company',
        string='Công ty',
        default=lambda self: self.env.company,
    )
    
    # Computed fields
    # line_ids = fields.One2many(
    #     comodel_name='{{MODEL_NAME}}.line',
    #     inverse_name='parent_id',
    #     string='Chi tiết',
    # )
    # total = fields.Float(
    #     string='Tổng cộng',
    #     compute='_compute_total',
    #     store=True,
    # )

    # =============================================
    # CONSTRAINTS
    # =============================================
    _sql_constraints = [
        ('name_uniq', 'UNIQUE(name)', 'Tên phải là duy nhất!'),
    ]

    @api.constrains('name')
    def _check_name(self):
        for record in self:
            if record.name and len(record.name) < 3:
                raise ValidationError(_('Tên phải có ít nhất 3 ký tự!'))

    # =============================================
    # ACTIONS
    # =============================================
    def action_confirm(self):
        for record in self:
            if record.state != 'draft':
                raise UserError(_('Chỉ có thể xác nhận bản ghi ở trạng thái Nháp!'))
            record.state = 'confirmed'

    def action_done(self):
        self.write({'state': 'done'})

    def action_cancel(self):
        self.write({'state': 'cancelled'})

    def action_draft(self):
        self.write({'state': 'draft'})
