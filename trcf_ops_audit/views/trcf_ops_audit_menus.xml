<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action: mở dashboard vận hành -->
        <record id="action_trcf_ops_audit_dashboard" model="ir.actions.act_url">
            <field name="name">Dashboard Vận Hành</field>
            <field name="url">/trcf_ops_audit/dashboard</field>
            <field name="target">self</field>
        </record>

        <!-- Root menu của app -->
        <menuitem id="trcf_ops_audit_root_menu"
                  name="TRCF Ops Audit"
                  sequence="28"/>

        <!-- Menu: Dashboard Vận Hành -->
        <menuitem id="trcf_ops_audit_dashboard_menu"
                  name="Dashboard Vận Hành"
                  parent="trcf_ops_audit_root_menu"
                  action="action_trcf_ops_audit_dashboard"
                  sequence="1"/>

        <!-- Action: mở Settings -->
        <record id="action_trcf_ops_audit_settings" model="ir.actions.act_window">
            <field name="name">Cấu hình Ops Audit</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context" eval="{'module': 'trcf_ops_audit'}"/>
        </record>

        <menuitem id="trcf_ops_audit_settings_menu"
                  name="Cấu hình"
                  parent="trcf_ops_audit_root_menu"
                  action="action_trcf_ops_audit_settings"
                  sequence="99"/>
    </data>
</odoo>
